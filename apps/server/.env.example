# Server Configuration Template
PORT=18787
NODE_ENV=development
DB_FILE_NAME=../../data/pwr.sqlite
PUBLIC_URL=http://localhost:18787

# Authentication Secret (REQUIRED - minimum 32 characters)
BETTER_AUTH_SECRET=

# Administrator Credentials (REQUIRED for database bootstrap)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional: 64-character hex key for encrypting provider webhook verification secrets
WEBHOOK_SIGNING_ENCRYPTION_KEY=
