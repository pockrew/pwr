{
  "name": "@pockrew/pwr-server",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.1",
  "author": {
    "name": "Thinh Dam Hung",
    "email": "thinhdh.dev@gmail.com"
  },
  "exports": {
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts",
      "require": "./src/rpc.ts",
      "default": "./src/rpc.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun src/db/seed.ts",
    "auth:generate": "bun --bun x @better-auth/cli generate --config src/modules/auth/configs.ts",
    "auth:migrate": "bun --bun x @better-auth/cli migrate --config src/modules/auth/configs.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@logtape/logtape": "2.3.8",
    "@pockrew/pwr-core": "workspace:*",
    "@pockrew/pwr-shared": "workspace:*",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "4.13.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
