# ==============================================================================
# PWR Server Deployment Configuration
# Copy this template to .env before starting the server container:
#   cp .env.example .env
#   docker compose up -d --build
# ==============================================================================

# Server Network Configuration
PORT=18787
NODE_ENV=production
# REQUIRED in production: the public https origin the server is reached at (used for Admin
# sign-in origins and secure cookies), e.g. https://hooks.example.com
PUBLIC_URL=

# Authentication Secret (REQUIRED)
# A random secret of at least 32 characters used to sign auth tokens and sessions.
# Generate with: `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Initial Administrator Credentials (REQUIRED for fresh database bootstrap)
# ADMIN_EMAIL is the permanent admin account identifier.
ADMIN_EMAIL=

# ADMIN_PASSWORD must be at least 8 characters. Required on initial database bootstrap.
# After the initial bootstrap, restarts preserve the account in the database.
ADMIN_PASSWORD=

# Administrator display name (default: Admin)
ADMIN_NAME=Admin

# Webhook Signing Encryption Key (required only for provider signature verification)
# 64-character hexadecimal key that encrypts GitHub/Stripe/Standard Webhooks/Shopify/Slack/HMAC
# signing secrets at rest. Back it up with the database; without it, signed modes are disabled.
# Generate with: `openssl rand -hex 32`
WEBHOOK_SIGNING_ENCRYPTION_KEY=

# Ingress & Rate Limiting Controls (Optional)
# MAX_INGRESS_PAYLOAD_BYTES=5242880
# TUNNEL_RATE_LIMIT_PER_SEC=50
# IP_RATE_LIMIT_PER_SEC=100
# TUNNEL_DAILY_QUOTA=20000
# Comma-separated IPs/CIDRs of your reverse proxy. Without it, X-Forwarded-For is ignored and
# every client appears as the proxy's IP.
# TRUSTED_PROXIES=

# Retention (days): payloads of fully delivered events, then event/delivery rows, then audit.
# SERVER_RETENTION_DAYS=7
# SERVER_METADATA_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=90

# Directory of the rotating JSON Lines server log read by Admin (default: logs/ beside the DB).
# LOG_DIR=
